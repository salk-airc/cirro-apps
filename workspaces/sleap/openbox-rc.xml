<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal openbox config: one desktop, SLEAP windows open maximized, no desktop menu clutter. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops><number>1</number></desktops>
  <applications>
    <application class="*">
      <decor>yes</decor>
    </application>
    <application title="SLEAP*">
      <maximized>yes</maximized>
    </application>
  </applications>
  <keyboard>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="Execute"><command>xterm</command></action></mousebind>
    </context>
  </mouse>
</openbox_config>
