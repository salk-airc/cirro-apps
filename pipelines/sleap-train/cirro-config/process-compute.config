// Compute configuration for Train Pose Model (SLEAP) main.
// Executor, queue and instance sizing come from the Cirro compute environment chosen
// at launch; the workflow's own config declares per-process cpu and memory requests.

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 2
}

// TRAIN carries label process_gpu when params.gpu is on: send it to Cirro's GPU queue.
// System.getenv, not "${PW_GPU_JOB_QUEUE}": a project without a GPU queue has no such
// variable, and the string form then fails to parse even for a CPU run.
process {
    withLabel: process_gpu {
        accelerator = 1
        queue = System.getenv('PW_GPU_JOB_QUEUE') ?: System.getenv('PW_SPOT_JOB_QUEUE')
    }
}
